# ==============================================================================
# Ferrow Foresight - Environment Variables
# ==============================================================================
# Zero-setup local default: when no .env.local exists, the app automatically runs
# with the local seed data backend and remote AI agent provider.
# To connect live external services, copy this file to .env.local and populate keys.

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration
# ------------------------------------------------------------------------------
# Public Supabase project URL (e.g. https://xyzcompany.supabase.co). Leave blank for seed fallback.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key for browser data queries. Leave blank for seed fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private Supabase service role secret for administrative database writes. Leave blank for seed fallback.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. AI Agent Provider & Multi-Provider Waterfall
# ------------------------------------------------------------------------------
# Provider mode sequence: 'auto' (direct -> make -> remote -> cached), or explicit override ('direct' | 'make' | 'remote' | 'cached'). Default: auto
AGENT_PROVIDER=auto

# Google AI Gemini API Key for direct model inference (get from https://aistudio.google.com). Leave blank to fall back.
GEMINI_API_KEY=

# Primary Gemini model ID for operational inference. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Fallback Gemini model ID when primary encounters quota/rate limits. Default: gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Make.com scenario webhook URL for external agent orchestrations. Leave blank to skip.
MAKE_WEBHOOK_URL=

# Optional Bearer token for authenticating with Make.com webhook.
MAKE_AUTH_TOKEN=

# Remote Ferrow AI agent endpoint for zero-setup execution. Defaults to https://ferrow-foresight.vercel.app/api/agent
REMOTE_AGENT_URL=https://ferrow-foresight.vercel.app/api/agent

# Maximum daily live LLM requests allowed before rate limiter falls back to cached responses. Default: 50
LIVE_AGENT_DAILY_CAP=50

# ------------------------------------------------------------------------------
# 3. Application State & Simulation Controls
# ------------------------------------------------------------------------------
# Controls whether demo simulation and /api/demo/reset endpoints are enabled ('true' | 'false'). Default: true
DEMO_MODE=true

# Base URL used by Playwright E2E scenario scripts and local runners. Default: http://localhost:3000
BASE_URL=http://localhost:3000
